<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.scivicslab</groupId>
    <artifactId>html-saurus-parent</artifactId>
    <version>2.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
      One module per mode, so a mode's code is not in the jar of a mode that must not run it.

      html-saurus serves a public site in production mode and runs on the author's own machine in
      portal mode. Both used to come out of one jar, with a boolean deciding which paths the
      server registered. The portal's half of that jar reaches into the machine it runs on —
      /mcp reads and writes files and rebuilds the site, and asks for no credential — so the
      public deployment carried code it must never run, kept unreachable by a runtime flag.

      It now carries none of it: html-saurus-production-server depends on html-saurus-lib and
      nothing else, so McpHandler, the import services and the OCR clients are absent from its
      jar, and with them PDFBox, POI and jsoup.

      html-saurus-lib holds what every mode needs and declares no HTTP endpoint at all.
    -->
    <modules>
        <module>html-saurus-lib</module>
        <module>html-saurus-build-only</module>
        <module>html-saurus-production-server</module>
        <module>html-saurus-portal-server</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- One version for every Lucene artifact: mixing them throws at class-load time. -->
        <lucene.version>10.5.2</lucene.version>
    </properties>

    <!--
      Transitive artifacts that arrive at a version with a published advisory. Each is pinned to
      the release that fixes it; the comment names who drags it in, so the pin can be dropped once
      that dependency ships the fixed version itself. Checked with
      https://api.osv.dev/v1/querybatch over the resolved dependency list.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.scivicslab</groupId>
                <artifactId>html-saurus-lib</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- via pojo-actor 4.2.0 — 2.20.0 carries 11 advisories (polymorphic-type-validator
                 bypasses, eager DNS resolution, parser DoS). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- via poi-ooxml -> commons-compress — uncontrolled recursion on long inputs. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.21.0</version>
            </dependency>
            <!-- via poi-ooxml — MapMessage JSON serialization of non-finite floats. Stays on the
                 2.x line; 3.0.0 is still beta. -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.26.1</version>
            </dependency>

            <!-- Lucene full-text search with Japanese (Kuromoji) analyzer -->
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-core</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-queryparser</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-kuromoji</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-queries</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-analysis-common</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-highlighter</artifactId>
                <version>${lucene.version}</version>
            </dependency>

            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>0.30.0</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>0.30.0</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
                <version>0.30.0</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-heading-anchor</artifactId>
                <version>0.30.0</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-autolink</artifactId>
                <version>0.30.0</version>
            </dependency>

            <dependency>
                <groupId>com.scivicslab</groupId>
                <artifactId>job-registry</artifactId>
                <version>0.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.scivicslab</groupId>
                <artifactId>openmath-lisp</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.scivicslab</groupId>
                <artifactId>pojo-actor</artifactId>
                <version>4.2.0</version>
            </dependency>
            <dependency>
                <groupId>com.scivicslab</groupId>
                <artifactId>gpu-broker-client</artifactId>
                <version>0.2.0</version>
            </dependency>

            <!-- PDF text extraction — the PDF import only, which is portal mode's -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>3.0.8</version>
            </dependency>
            <!-- Word (.docx) text and embedded-image extraction — the Word import only -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>5.5.1</version>
            </dependency>
            <!-- HTML fetch and article-text extraction — the Web page import only -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>1.23.2</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>1.52.0</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                    <configuration>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
